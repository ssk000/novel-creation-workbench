{
  "name": "novel-workbench-launcher",
  "version": "1.0.0",
  "description": "小说创作工作台启动器",
  "author": "Novel Workbench",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.novelworkbench.launcher",
    "productName": "NovelWorkbench",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "harness.js",
      "renderer/**/*"
    ],
    "win": {
      "target": ["portable"],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "NovelWorkbench-Launcher.exe"
    }
  }
}
